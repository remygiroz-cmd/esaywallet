// easyWallet — data model
// Docs: https://pris.ly/d/prisma-schema
//
// Note: "type" fields are stored as String rather than native enums to keep
// the model portable. Allowed values are documented inline and enforced in
// application code (see src/lib/constants.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (Supabase transaction pooler) used at runtime.
  url       = env("DATABASE_URL")
  // Direct connection used for migrations.
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profiles Profile[]
}

// A portfolio "owner" under a single login — typically the user themself,
// but also lets one login track a child's or partner's portfolio in
// isolation. Every data-bearing entity (wallets, assets, documents…)
// hangs off a Profile rather than the User directly. The active profile
// is held in a cookie; switching it scopes the whole app to that profile.
model Profile {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  // True for the profile auto-created when the account is created. Used
  // as the default active profile and protected from deletion when it's
  // the only one left.
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wallets             Wallet[]
  assets              Asset[]
  snapshots           PortfolioSnapshot[]
  taxAdjustments      TaxAdjustment[]
  priceAlerts         PriceAlert[]
  realizedGainEntries RealizedGainEntry[]
  documents           Document[]

  @@index([userId])
}

// A stored file in the document vault — bank statements, broker exports,
// tax forms… kept with the user's data rather than as a public URL. The
// raw bytes live in the database (covered by the database's encryption
// at rest) and are only ever served back through an authenticated route.
model Document {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name      String // original file name
  mimeType  String
  size      Int // bytes
  category  String // RELEVE | TRANSACTIONS | DIVIDENDES | IMPOT | AUTRE
  year      Int? // optional tax year
  note      String?
  content   Bytes // the file itself
  createdAt DateTime @default(now())

  @@index([profileId])
}

// User-entered figures the app can't derive — currently the
// carry-forward capital losses from previous years, per tax year.
model TaxAdjustment {
  id               String   @id @default(cuid())
  profileId        String
  profile          Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  year             Int
  carryForwardLoss Decimal  @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([profileId, year])
}

model Wallet {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name      String
  type      String // CTO | PEA | CRYPTO | LIVRET | OTHER
  currency  String   @default("EUR") // reference currency of the wallet
  // Optional tax-rate override (ratio, e.g. 0.30). Falls back to the
  // type-based default when null.
  taxRate   Float?
  // Account opening date — used for the PEA 5-year rule when estimating tax.
  openedAt  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions       Transaction[]
  income             Income[]
  cashMovements      CashMovement[]
  snapshots          PortfolioSnapshot[]
  realizedGainEntries RealizedGainEntry[]

  @@index([profileId])
}

// A pre-computed realised gain/loss line from a bank's tax statement
// (e.g. a Boursorama CTO "imprimé fiscal unique"). The bank has already
// done the cost-basis maths, so this is imported as an authoritative
// figure rather than reconstructed from transactions.
model RealizedGainEntry {
  id           String   @id @default(cuid())
  profileId    String
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  walletId     String?
  wallet       Wallet?  @relation(fields: [walletId], references: [id], onDelete: SetNull)
  year         Int
  securityName String
  securityCode String? // ISIN, when provided
  proceeds     Decimal  @default(0) // total disposals (cessions)
  realizedGain Decimal // +/- value réalisée
  source       String? // file name / bank label
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([profileId])
  @@index([walletId])
}

// A cash deposit into or withdrawal from a wallet, in the wallet currency.
// Combined with buys, sells and income, it gives the wallet's cash balance.
model CashMovement {
  id         String   @id @default(cuid())
  walletId   String
  wallet     Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  kind       String // DEPOSIT | WITHDRAWAL
  amount     Decimal // always positive, in the wallet currency
  occurredAt DateTime
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([walletId])
}

model Asset {
  id            String   @id @default(cuid())
  profileId     String
  profile       Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  symbol        String // internal ticker / identifier
  name          String
  type          String // STOCK | ETF | CRYPTO
  quoteCurrency String   @default("EUR") // currency the asset is priced in
  // External provider identifiers used to fetch live prices
  coingeckoId   String?
  yahooSymbol   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  transactions Transaction[]
  income       Income[]
  priceAlerts  PriceAlert[]
  price        PriceCache?

  @@unique([profileId, symbol, type])
  @@index([profileId])
}

// A user-defined price threshold for an asset. Evaluated on every dashboard
// refresh; once the live price crosses the threshold, triggeredAt is set and
// the alert surfaces as a banner on the dashboard.
model PriceAlert {
  id          String    @id @default(cuid())
  profileId   String
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  assetId     String
  asset       Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  direction   String // ABOVE | BELOW
  threshold   Decimal // price in the asset's quote currency
  note        String?
  triggeredAt DateTime? // set when the live price first crosses the threshold
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([profileId])
  @@index([assetId])
}

// Income received from a holding — dividends, coupons, staking rewards or
// interest. Tracked separately from buy/sell transactions.
model Income {
  id         String   @id @default(cuid())
  walletId   String
  wallet     Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  assetId    String
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Restrict)
  kind       String // DIVIDEND | COUPON | STAKING | INTEREST
  receivedAt DateTime
  amount     Decimal // gross income received, in the wallet currency
  fees       Decimal  @default(0)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([walletId])
  @@index([assetId])
}

model Transaction {
  id             String   @id @default(cuid())
  walletId       String
  wallet         Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  assetId        String
  asset          Asset    @relation(fields: [assetId], references: [id], onDelete: Restrict)
  type           String   @default("BUY") // BUY | SELL
  executedAt     DateTime // purchase/sale date
  unitPrice      Decimal // price per unit, in the asset quote currency
  quantity       Decimal // number of units received/sold
  amountInvested Decimal // total amount invested, in the wallet currency
  fees           Decimal  @default(0)
  // A SELL that is not a taxable disposal — e.g. a crypto-to-crypto swap,
  // or a transfer. Excluded from the taxable base in the Fiscalité view.
  taxExempt      Boolean  @default(false)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([walletId])
  @@index([assetId])
}

// Latest known price for an asset (refreshed by the price service).
model PriceCache {
  id        String   @id @default(cuid())
  assetId   String   @unique
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  price     Decimal
  currency  String
  // 24-hour price change, as a percentage (e.g. 2.5 = +2.5%).
  change24h Float?
  fetchedAt DateTime @default(now())
}

// Cached foreign-exchange rate (e.g. USD -> EUR) for currency conversion.
model FxRate {
  id        String   @id @default(cuid())
  base      String
  quote     String
  rate      Decimal
  fetchedAt DateTime @default(now())

  @@unique([base, quote])
}

// Daily snapshot of portfolio value, feeding the historical performance chart.
// walletId null = snapshot across all wallets for the profile.
model PortfolioSnapshot {
  id            String   @id @default(cuid())
  profileId     String
  profile       Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  walletId      String?
  wallet        Wallet?  @relation(fields: [walletId], references: [id], onDelete: Cascade)
  date          DateTime
  totalValue    Decimal // portfolio value in the reference currency
  totalInvested Decimal
  currency      String   @default("EUR")
  createdAt     DateTime @default(now())

  @@unique([profileId, walletId, date])
  @@index([profileId, date])
}
